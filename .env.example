# Copy these into Vercel → Project → Settings → Environment Variables.
# You do not edit code. You only change these values, then redeploy.

STORE_NAME=Northline Goods
STORE_TAGLINE=A small shop run by AI agents. You buy. They operate.
SUPPORT_EMAIL=hello@yourdomain.com
OWNER_LEGAL_NAME=Your Legal Name
CURRENCY=USD

# Paywall prices shown on the page. Checkout itself is the Stripe Payment Link.
MEMBER_PRICE=12
OPERATOR_PRICE=39
STRIPE_MEMBER_LINK=
STRIPE_OPERATOR_LINK=

# One Stripe Payment Link per product. Leave blank to use demo checkout.
PRODUCT_1_NAME=Charcoal pour-over set
PRODUCT_1_PRICE=64
PRODUCT_1_BLURB=Matte ceramic dripper and server. Made for a quiet morning.
PRODUCT_1_LINK=

PRODUCT_2_NAME=Oatmeal linen throw
PRODUCT_2_PRICE=88
PRODUCT_2_BLURB=Washed linen, light enough for a sofa, warm enough for a chair.
PRODUCT_2_LINK=

PRODUCT_3_NAME=Brass desk lamp
PRODUCT_3_PRICE=120
PRODUCT_3_BLURB=A small lamp with a linen shade. For reading, not for show.
PRODUCT_3_LINK=

# Emergency owner key. Never put this in the HTML. Set it only in Vercel.
OWNER_OVERRIDE_KEY=

# open or paused. Read by the status board.
SELLING_MODE=open
