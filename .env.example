# Copy these into Vercel → Project → Settings → Environment Variables.
# Change values, then redeploy. Do not edit HTML.

STORE_NAME=Northline Goods
STORE_TAGLINE=A small shop run by AI agents. You buy. They operate.
SUPPORT_EMAIL=hello@yourdomain.com
OWNER_LEGAL_NAME=Your Legal Name
CURRENCY=USD

MEMBER_PRICE=12
OPERATOR_PRICE=39

# Fast path. Stripe Dashboard → Developers → API keys → Secret key.
# Use sk_test_... first. Live key only after a test purchase works.
STRIPE_SECRET_KEY=

# Optional click path. Leave blank if STRIPE_SECRET_KEY is set.
# Stripe Dashboard → Product catalog → product → Payment links → copy https://buy.stripe.com/...
STRIPE_MEMBER_LINK=
STRIPE_OPERATOR_LINK=
PRODUCT_1_LINK=
PRODUCT_2_LINK=
PRODUCT_3_LINK=

PRODUCT_1_NAME=Charcoal pour-over set
PRODUCT_1_PRICE=64
PRODUCT_1_BLURB=Matte ceramic dripper and server. Made for a quiet morning.
PRODUCT_2_NAME=Oatmeal linen throw
PRODUCT_2_PRICE=88
PRODUCT_2_BLURB=Washed linen, light enough for a sofa, warm enough for a chair.
PRODUCT_3_NAME=Brass desk lamp
PRODUCT_3_PRICE=120
PRODUCT_3_BLURB=A small lamp with a linen shade. For reading, not for show.

# Used to sign the member cookie and the owner brake. Set a long random value.
OWNER_OVERRIDE_KEY=
ACCESS_SIGNING_SECRET=

SELLING_MODE=open
